# URL pública del sitio (usada en metadata, sitemap y robots)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Número de WhatsApp en formato internacional, sin + ni espacios.
# Ejemplo: 56912345678
NEXT_PUBLIC_WHATSAPP_NUMBER=

# URL interna de api-central. Sin barra final.
# Si no se define, el catálogo usa datos de ejemplo.
API_CENTRAL_URL=http://localhost:3001
